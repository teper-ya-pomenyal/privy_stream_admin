# Адрес Gateway для dev/preview-прокси (vite.config.ts).
GATEWAY_URL=http://localhost:8080

# Базовый URL API в собранном бандле. Пусто — запросы идут на тот же origin
# (админка раздаётся самим Gateway или через reverse-proxy).
# Если задан другой origin, в Gateway должен быть разрешён CORS.
VITE_API_URL=
